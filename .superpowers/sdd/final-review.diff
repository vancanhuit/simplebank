-run = 'go test -race -cover -v ./cmd/... -tags=integration'
+run = 'go test -race -cover -v ./... -tags=integration'
 
 [tasks."docker:build"]
 description = "Build docker image"
 run = 'docker buildx build --platform linux/amd64,linux/arm64 -t simplebank:latest --load .'
 
 [tasks."hooks:install"]
 description = "Install git hooks"
 run = 'cog install-hook --all'
+
+[tasks."sqlc:generate"]
+description = "Generate Go code from SQL with sqlc"
+run = [
+  'go install github.com/sqlc-dev/sqlc/cmd/sqlc@latest',
+  'sqlc generate',
+]
diff --git a/sqlc.yaml b/sqlc.yaml
new file mode 100644
index 0000000..5828922
--- /dev/null
+++ b/sqlc.yaml
@@ -0,0 +1,18 @@
+version: "2"
+sql:
+  - engine: "postgresql"
+    schema: "internal/db/migrations"
+    queries: "internal/db/query"
+    gen:
+      go:
+        package: "db"
+        out: "internal/db/sqlc"
+        sql_package: "pgx/v5"
+        emit_json_tags: true
+        emit_interface: true
+        emit_empty_slices: true
+        overrides:
+          - db_type: "uuid"
+            go_type: "github.com/google/uuid.UUID"
+          - db_type: "timestamptz"
+            go_type: "time.Time"
